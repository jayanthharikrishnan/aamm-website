# Local: node --env-file=.env server.js
# Production: configure these in Render's environment/secret settings.
NODE_ENV=development
PORT=3000

# Absolute path on a persistent disk in production.
# Keep the existing database; never restore/copy the repository DB on every start.
DB_PATH=./database.db
# Exact customer-facing origin. Local example:
APP_ORIGIN=http://localhost:3000

# Configure administrator access explicitly; no default administrator password.
ADMIN_ID=9344898473
ADMIN_PHONE=9344898473
ADMIN_PASSWORD=

# Inherited original click-to-chat and supplied location links.
WHATSAPP_NUMBER=919344898473
GOOGLE_MAPS_URL=https://maps.app.goo.gl/2G5aei6qZseprHf38

# Optional real customer OTP via Twilio Verify. All three are required.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional real assistant provider. Without a key, catalogue search remains search.
OPENAI_API_KEY=

# Optional assistant model.
OPENAI_MODEL=gpt-4.1-mini

# Use Razorpay TEST credentials until real end-to-end merchant verification passes.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional verified billing address. Omit until actual business details are supplied.
BILLING_BUSINESS_ADDRESS=

# Optional transactional SMS sender. Twilio Verify alone does not configure these.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Public Google Identity Services Web application OAuth client ID (no client secret needed).
GOOGLE_CLIENT_ID=
